# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# Environment
.env
.env.*
!.env.example

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker
*.log

# Node
node_modules/
frontend/node_modules/

# OS
.DS_Store
Thumbs.db

# Terraform — local state can contain resource IDs, ARNs, and (with some
# providers) plaintext secrets from data sources. Never commit it; the
# planned Phase 8 move to S3 remote state makes this even more of a hazard
# to have sitting untracked in the working tree.
# (.terraform.lock.hcl is deliberately NOT ignored: the provider lockfile is
# committed so provider resolution is identical across machines and CI.)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# Claude Code local config
.claude/

# Session context archives (context/README.md). Deliberately NOT committed:
# transcripts carry live credentials, and the raw set is >100MB of binary that
# git would keep forever. context/INDEX.md is the committed part and is the
# part a new session actually reads.
context/archives/*
!context/archives/.gitkeep
