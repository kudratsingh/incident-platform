# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="Incident Platform"
ENVIRONMENT=development          # development | production
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FILE=                        # e.g. logs/app.log — leave blank to log to stdout only

# ── Database ───────────────────────────────────────────────────────────────────
# asyncpg DSN — swap credentials and host for your managed Postgres instance
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/incident_platform

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── SSE streaming ──────────────────────────────────────────────────────────────
# The SSE path runs on its own Redis pool so open streams can never starve the
# rate limiter, backpressure check and worker loops that share the default
# 20-connection pool. The fan-out broker holds ONE Pub/Sub connection for the
# whole process regardless of viewer count, so this is reconnect headroom, not
# a per-viewer budget. See docs/REDIS.md.
SSE_REDIS_MAX_CONNECTIONS=5
# Concurrent open streams per API process; past it the stream GET answers 503
# with Retry-After. 0 disables the cap.
SSE_MAX_CONCURRENT_STREAMS=200
# Close a stream that has seen no event for this long (the browser reconnects),
# and never let one outlive the hard ceiling. 0 disables either timeout.
SSE_STREAM_IDLE_TIMEOUT_SECONDS=300
SSE_STREAM_MAX_DURATION_SECONDS=3600
SSE_RETRY_AFTER_SECONDS=5

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Object storage (MinIO locally / S3 in production) ─────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
# Development-only MinIO credentials. Production uses the ECS task IAM role
# instead, and boot refuses 'minioadmin' when ENVIRONMENT=production.
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=incident-platform

# ── Worker tuning ──────────────────────────────────────────────────────────────
# How many times a job may RUN in total: the original run plus its retries.
# 3 means three runs and two retries, and the job dead-letters when the third
# run fails. Stamped onto each new job row at creation, so it applies to jobs
# created after the change, not retroactively — the dispatcher reads the
# ceiling off the row it is running.
MAX_JOB_ATTEMPTS=3
# Deprecated name for MAX_JOB_ATTEMPTS, accepted for one release. If only this
# is set the platform uses it and logs a deprecation warning at startup; if
# both are set and disagree it refuses to start. It never held a retry count —
# it capped total runs, exactly as MAX_JOB_ATTEMPTS does (WO-R2-172).
# MAX_JOB_RETRIES=3
JOB_RETRY_BACKOFF_BASE=2.0

# ── Browser origins (JSON array, not a comma-separated string) ─────────────────
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Worker deadlines, liveness and admission ──────────────────────────────────
# Execution deadline must stay below the abandoned-RUNNING recovery threshold.
JOB_EXECUTION_TIMEOUT_SECONDS=600.0
STALE_RUNNING_THRESHOLD_SECONDS=900
WORKER_HEARTBEAT_INTERVAL_SECONDS=15.0
WORKER_HEARTBEAT_STALE_SECONDS=60.0
OUTBOX_MAX_ATTEMPTS=900
MAX_JOB_PAYLOAD_BYTES=262144
BACKPRESSURE_LAG_THRESHOLD=1000

# ── Kafka / Redpanda ─────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_JOB_SUBMITTED=job.submitted
KAFKA_TOPIC_JOB_PROGRESS=job.progress
KAFKA_TOPIC_JOB_COMPLETED=job.completed
KAFKA_TOPIC_JOB_FAILED=job.failed
KAFKA_TOPIC_JOB_CANCELLED=job.cancelled
KAFKA_TOPIC_JOB_DLQ=job.dlq
KAFKA_CONSUMER_GROUP_WORKER=worker-dispatcher
KAFKA_CONSUMER_GROUP_AUDIT=audit-writer
KAFKA_CONSUMER_GROUP_SSE=sse-broadcaster
KAFKA_CONSUMER_GROUP_EVENT_LOG=event-log
KAFKA_CONSUMER_GROUP_READ_MODEL=read-model
KAFKA_CONSUMER_GROUP_DEPENDENCY=dependency-resolver
KAFKA_CONSUMER_GROUP_SAGA=saga-coordinator
KAFKA_CONSUMER_GROUP_TRIAGE=llm-triage
KAFKA_MAX_POLL_INTERVAL_MS=300000
KAFKA_SESSION_TIMEOUT_MS=30000

# ── Per-principal rate limits ────────────────────────────────────────────────
MCP_RATE_LIMIT_PER_PRINCIPAL=120
MCP_RATE_LIMIT_WINDOW_SECONDS=60
ADMIN_NL_QUERY_RATE_LIMIT=10
ADMIN_DIGEST_RATE_LIMIT=5
ADMIN_PAID_RATE_LIMIT_WINDOW_SECONDS=60

# ── Optional LLM features (off; enabling them can incur API charges) ──────────
# Export ANTHROPIC_API_KEY in the service environment; the SDK reads it directly.
# ANTHROPIC_API_KEY=replace-with-your-api-key
LLM_TRIAGE_ENABLED=false
LLM_TRIAGE_MODEL=claude-opus-4-7
LLM_TRIAGE_TIMEOUT_SECONDS=10.0
LLM_RETRY_POLICY_ENABLED=false
LLM_RETRY_POLICY_MODEL=claude-opus-4-7
LLM_RETRY_POLICY_MIN_RETRY_COUNT=1
LLM_RETRY_POLICY_TIMEOUT_SECONDS=10.0
LLM_NL_QUERY_ENABLED=false
LLM_NL_QUERY_MODEL=claude-opus-4-7
LLM_NL_QUERY_TIMEOUT_SECONDS=10.0
LLM_DIGEST_ENABLED=false
LLM_DIGEST_MODEL=claude-opus-4-7
LLM_DIGEST_TIMEOUT_SECONDS=10.0
LLM_DIGEST_INTERVAL_HOURS=24
LLM_DIGEST_WINDOW_HOURS=24
LLM_DIGEST_MAX_ERROR_SAMPLES=1000

# ── Lab features (never enable in production) ─────────────────────────────────
SEED_EVAL_FIXTURES=false
CHAOS_ENABLED=false
# The read-only account whose X-Lab-Principal credential may label a tools/call
# `lab.probe` (ADR 0038). Only read while CHAOS_ENABLED=true.
# LAB_PROBE_SMOKE_ACCOUNT_NAME=incident-commander-smoke

# ── Outbound alert webhook (leave both unset to use polling only) ─────────────
# ALERT_WEBHOOK_URL=http://localhost:8001/webhooks/alerts
# ALERT_WEBHOOK_SECRET=replace-with-a-random-signing-secret
ALERT_WEBHOOK_TIMEOUT_SECONDS=5.0

# ── The metrics pass, and the alert rules that ride it (ADR 0039) ────────────
# How often the worker measures queue depth, in-flight jobs and consumer lag. The lag
# value key's TTL and the density of the 15-minute lag window are derived from it. The
# demo stack sets 5 so a watched number moves; 60 is the default everywhere else.
METRICS_LOOP_INTERVAL_SECONDS=60.0
# The platform's own alert rules — `consumer_stalled` and `dlq_depth_warning`. ON by
# default; set false where a real pager owns these conditions.
ALERT_RULES_ENABLED=true
CONSUMER_LAG_ALERT_THRESHOLD=20
DLQ_DEPTH_ALERT_THRESHOLD=5

# ── SLO evaluation and tracing ───────────────────────────────────────────────
SLO_EVALUATION_INTERVAL_SECONDS=300.0
SLO_ALERT_DEDUP_WINDOW_SECONDS=3600.0
# OTLP_ENDPOINT=http://localhost:4318

# ── Migration owner (not the application's runtime role) ─────────────────────
# Export only for Alembic; this is read directly, not through Settings.
# ALEMBIC_DATABASE_URL=postgresql+asyncpg://migration_owner:replace-me@localhost:5432/incident_platform
