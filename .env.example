# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="Incident Platform"
ENVIRONMENT=development          # development | production
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FILE=                        # e.g. logs/app.log — leave blank to log to stdout only

# ── Database ───────────────────────────────────────────────────────────────────
# asyncpg DSN — swap credentials and host for your managed Postgres instance
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/incident_platform

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── SSE streaming ──────────────────────────────────────────────────────────────
# The SSE path runs on its own Redis pool so open streams can never starve the
# rate limiter, backpressure check and worker loops that share the default
# 20-connection pool. The fan-out broker holds ONE Pub/Sub connection for the
# whole process regardless of viewer count, so this is reconnect headroom, not
# a per-viewer budget. See docs/REDIS.md.
SSE_REDIS_MAX_CONNECTIONS=5
# Concurrent open streams per API process; past it the stream GET answers 503
# with Retry-After. 0 disables the cap.
SSE_MAX_CONCURRENT_STREAMS=200
# Close a stream that has seen no event for this long (the browser reconnects),
# and never let one outlive the hard ceiling. 0 disables either timeout.
SSE_STREAM_IDLE_TIMEOUT_SECONDS=300
SSE_STREAM_MAX_DURATION_SECONDS=3600
SSE_RETRY_AFTER_SECONDS=5

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Object storage (MinIO locally / S3 in production) ─────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
# Development-only MinIO credentials. Production uses the ECS task IAM role
# instead, and boot refuses 'minioadmin' when ENVIRONMENT=production.
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=incident-platform

# ── Worker tuning ──────────────────────────────────────────────────────────────
# Retry budget stamped onto each new job row at creation. Applies to jobs
# created after the change, not retroactively — the dispatcher reads the
# ceiling off the row it is running.
MAX_JOB_RETRIES=3
JOB_RETRY_BACKOFF_BASE=2.0
